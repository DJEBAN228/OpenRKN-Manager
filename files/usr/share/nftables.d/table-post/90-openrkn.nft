# Loaded atomically with fw4, including on every firewall reload.
# Observation only. External Zapret owns NFQUEUE rules in postrouting.
# Never enqueue a second time here or assume its queue number / fwmark.
chain openrkn_output {
	type filter hook output priority mangle + 1; policy accept;
	oifname "lo" return
	fib daddr type local return
	meta skuid 453 meta l4proto { tcp, udp } counter
}
