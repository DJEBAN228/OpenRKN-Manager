{
  "openrkn-read": {
    "description": "Read OpenRKN status and logs",
    "read": {
      "ubus": {
        "openrkn": [
          "status",
          "get_logs",
          "capabilities",
          "dpi_state",
          "get_config"
        ],
        "session": [
          "access",
          "destroy"
        ]
      }
    }
  },
  "openrkn-admin": {
    "description": "Control OpenRKN and export secret-bearing client profiles",
    "read": {
      "ubus": {
        "openrkn": [
          "status",
          "get_logs",
          "capabilities",
          "dpi_state",
          "get_config"
        ],
        "session": [
          "access",
          "destroy"
        ]
      }
    },
    "write": {
      "ubus": {
        "openrkn": [
          "start_service",
          "stop_service",
          "gen_mobile_profile",
          "restart_service",
          "configure"
        ]
      }
    }
  }
}
