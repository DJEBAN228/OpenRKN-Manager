#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
if [ "$1" = list ]; then
	printf '%s\n' '{"status":{},"capabilities":{},"dpi_state":{},"get_config":{},"configure":{"transport":"","url":"","share_host":"","dpi_enabled":true},"start_service":{"service":"","mode":"","strategy":"","preset":""},"restart_service":{"service":"","mode":"","strategy":"","preset":""},"stop_service":{"service":""},"gen_mobile_profile":{},"get_logs":{"lines":100,"service":""}}'
	exit 0
fi
[ "$1" = call ] || exit 1
. /usr/lib/openrkn/common.sh
umask 077

status() (
	or_config
	services=$(or_service_json)
	flux_pid=$(or_pid openflux "$OR_FLUX")
	nfq_pid=$(or_pid nfqws "$OR_NFQ")
	json_init
	json_add_boolean ok 1
	json_add_boolean desired "$([ -f "$OR_RUN/desired" ] && echo 1 || echo 0)"
	json_add_string mode "$OR_MODE"
	json_add_string strategy "$OR_STRATEGY"
	json_add_boolean dpi_enabled "$OR_DPI_ENABLED"
	json_add_string state "$([ -n "$flux_pid" ] && { [ "$OR_DPI_ENABLED" = 0 ] || [ -n "$nfq_pid" ]; } && echo ONLINE || { [ -f "$OR_RUN/desired" ] && echo DEGRADED || echo STOPPED; })"
	. /usr/lib/openrkn/telemetry.sh
	or_telemetry
	json_add_object services
	for name in openflux zapret; do
		case "$name" in openflux) pid=$flux_pid;; zapret) pid=$nfq_pid;; esac
		json_add_object "$name"
		json_add_boolean running "$([ -n "$pid" ] && echo 1 || echo 0)"
		json_close_object
	done
	json_close_object
	json_add_object openflux
	json_add_boolean running "$([ -n "$flux_pid" ] && echo 1 || echo 0)"
	json_add_string transport "$(awk '
		/^\[Transport/ {section=1;next} /^\[/ {section=0}
		section && /^[[:space:]]*Type[[:space:]]*=/ {sub(/^[^=]*=[[:space:]]*/, "");sub(/[[:space:]]*[#;].*$/, "");printf "%s%s",sep,$0;sep=", "}' "$OR_CONF" 2>/dev/null)"
	json_close_object
	json_add_object processes
	for name in openflux nfqws; do
		case "$name" in openflux) pid=$flux_pid;; nfqws) pid=$nfq_pid;; esac
		json_add_object "$name"
		json_add_boolean running "$([ -n "$pid" ] && echo 1 || echo 0)"
		json_add_int pid "${pid:-0}"
		if [ -n "$pid" ]; then
			rss=$(awk '/^VmRSS:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
			json_add_int rss_kib "${rss:-0}"
		fi
		json_close_object
	done
	json_add_boolean watchdog "$(or_instance_running "$services" watchdog && echo 1 || echo 0)"
	json_close_object
	json_add_boolean nfqueue_rule "$(nft list chain inet fw4 openrkn_output >/dev/null 2>&1 && echo 1 || echo 0)"
	json_dump
)

capabilities() {
	printf '%s\n' '{"ok":true,"api_version":2,"service_scope":"stack","modes":["hybrid"],"features":["status","dpi_state","get_config","configure","start_service","stop_service","restart_service","gen_mobile_profile","get_logs"],"unsupported":["sessions","kick_session","autotest","cores","tg_proxies","clients","set_client_profile","diag_check","traceroute"]}'
}

dpi_state() (
	or_config
	json_load '{"ok":true,"engine":"zapret","engines":[{"id":"zapret","name":"nfqws","desc":"Исходящие соединения OpenFlux / UID 453"}],"presets":[{"id":"general","name":"General","desc":"TCP fake + multisplit, badseq; QUIC fake ×6","tags":["TCP","TLS","QUIC"]},{"id":"youtube4k","name":"YouTube","desc":"TCP fake + multisplit, md5sig; QUIC fake ×6","tags":["TCP","QUIC"]},{"id":"discord-voice","name":"Discord Voice","desc":"TCP badseq; UDP 443 и 50000–50100 fake ×6","tags":["TCP","UDP"]}]}'
	case "$OR_STRATEGY" in youtube) OR_STRATEGY=youtube4k;; discord) OR_STRATEGY=discord-voice;; esac
	json_add_string preset "$OR_STRATEGY"
	json_dump
)

get_logs() (
	read -r input
	json_load "$input" || { or_error invalid_json; return; }
	json_get_type kind lines
	json_get_var lines lines
	json_get_var log_service service
	[ -n "$log_service" ] || log_service=all
	case "$log_service" in all|nfqws|openflux|watchdog) ;; *) or_error unsupported_log_service; return;; esac
	if [ -z "$kind" ]; then lines=100
	elif [ "$kind" != int ]; then or_error invalid_lines; return
	fi
	case "$lines" in ''|*[!0-9]*) or_error invalid_lines; return;; esac
	[ "${#lines}" -le 4 ] && [ "$lines" -ge 1 ] && [ "$lines" -le 1000 ] || {
		or_error invalid_lines; return
	}
	logs=
	if [ -f "$OR_LOG" ]; then
		logs=$(awk -v svc="$log_service" 'svc=="all" || index($0, " " svc ":")' "$OR_LOG" | tail -n "$lines" | tail -c 65536)
	fi
	json_init
	json_add_boolean ok 1
	json_add_string logs "$logs"
	json_add_int requested_lines "$lines"
	json_add_string service "$log_service"
	json_dump
)

mutate() (
	action="$1" rc=0
	mkdir /var/lock/openrkn-rpc.lock 2>/dev/null || { or_error busy; return; }
	trap 'rmdir /var/lock/openrkn-rpc.lock 2>/dev/null' 0
	trap 'exit 1' INT TERM
	if [ "$action" = gen_mobile_profile ]; then
		/usr/libexec/openrkn/profile
		return
	fi
	if [ "$action" = configure ]; then
		. /usr/lib/openrkn/settings.sh
		or_settings
		return
	fi
	read -r input 2>/dev/null
	[ -n "$input" ] || input='{}'
	json_load "$input" || { or_error invalid_json; return; }
	json_get_var req_service service
	json_get_var req_mode mode
	json_get_var req_strat strategy
	json_get_var req_preset preset
	case "$req_service" in ''|openrkn) ;; *) or_error service_control_is_stack_only; return;; esac
	case "$req_mode" in ''|hybrid) ;; *) or_error unsupported_mode; return;; esac
	[ -z "$req_strat" ] || [ -z "$req_preset" ] || [ "$req_strat" = "$req_preset" ] || { or_error conflicting_strategy; return; }
	[ -n "$req_strat" ] || req_strat=$req_preset
	. /usr/lib/openrkn/presets.sh
	[ -z "$req_strat" ] || or_preset_valid "$req_strat" || { or_error unsupported_strategy; return; }
	if [ "$action" != stop ]; then
		or_config
		[ "$OR_ENABLED" = 1 ] || { or_error disabled_in_uci; return; }
		if [ -n "$req_mode" ] || [ -n "$req_strat" ]; then
			[ -z "$req_mode" ] || uci -q set "openrkn.main.mode=$req_mode" || { or_error config_failed; return; }
			[ -z "$req_strat" ] || uci -q set "openrkn.main.strategy=$req_strat" || { or_error config_failed; return; }
			uci -q commit openrkn || { or_error config_failed; return; }
			# Parameters must be applied even when the stack is already running.
			[ ! -f "$OR_RUN/desired" ] || action=restart
		fi
	fi
	/etc/init.d/openrkn "$action" >/dev/null 2>&1 || rc=$?
	[ "$rc" = 0 ] || { or_error service_action_failed; return; }
	json_init
	json_add_boolean ok 1
	json_add_string action "$action"
	json_add_string state "$([ "$action" = stop ] && echo stopping || echo starting)"
	json_dump
)

case "$2" in
	status) status;;
	capabilities) capabilities;;
	get_config) . /usr/lib/openrkn/settings.sh; or_get_settings;;
	configure) mutate configure;;
	dpi_state) dpi_state;;
	restart_service) mutate restart;;
	get_logs) get_logs;;
	start_service) mutate start;;
	stop_service) mutate stop;;
	gen_mobile_profile) mutate gen_mobile_profile;;
	*) or_error unknown_method;;
esac
