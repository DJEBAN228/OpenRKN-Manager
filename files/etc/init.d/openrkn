#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    . /usr/lib/openrkn/common.sh
    or_config
    [ "$OR_ENABLED" = 1 ] || return 0
    [ "$OR_MODE" = hybrid ] || { logger -t openrkn "Unsupported mode: $OR_MODE"; return 1; }
    services=$(or_service_json)
    if or_instance_running "$services" openflux; then return 0; fi
    [ -x "$OR_FLUX" ] && [ -r "$OR_CONF" ] || { logger -t openrkn 'Missing OpenFlux or exit.conf'; return 1; }
    . /usr/lib/openrkn/transports.sh
    or_transports_valid "$OR_CONF" || { logger -t openrkn 'Configure a supported transport and its URL before starting'; return 1; }
    [ "$(id -u openrkn 2>/dev/null)" = 453 ] || { logger -t openrkn 'openrkn must have UID 453'; return 1; }
    [ "$(uci -q get firewall.@defaults[0].auto_includes)" != 0 ] || return 1
    fw4 check >/dev/null 2>&1 || return 1
    . /usr/lib/openrkn/zapret.sh
    or_zapret_probe
    [ "$ZP_STATE" = detected ] || logger -t openrkn "External Zapret needs attention: $ZP_STATE"
    umask 077
    mkdir -p "$OR_RUN" /etc/openrkn/profiles || return 1
    chown openrkn:openrkn "$OR_RUN" || return 1
    chmod 700 "$OR_RUN" /etc/openrkn/profiles
    [ ! -L "$OR_LOG" ] || return 1
    touch "$OR_LOG" || return 1
    chown openrkn:openrkn "$OR_LOG" || return 1
    chmod 600 "$OR_LOG"
    rm -f "$OR_RUN/share.link" "$OR_RUN/openflux.pid"
    touch "$OR_RUN/desired"
    fw4 reload >/dev/null 2>&1 || { rm -f "$OR_RUN/desired"; return 1; }

    procd_open_instance openflux
    procd_set_param command /usr/libexec/openrkn/runner openflux "$OR_FLUX" "--config=$OR_CONF" --role=exit --mode=l4 --share
    if [ "$OR_ENCRYPTION" = enabled ] && [ "$OR_SESSION" = strict ]; then procd_append_param command --negotiate; fi
    [ -z "$OR_SHARE_HOST" ] || procd_append_param command "--share-host=$OR_SHARE_HOST"
    procd_set_param user openrkn
    procd_set_param group openrkn
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 5
    procd_set_param file "$OR_CONF" /etc/config/openrkn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance watchdog
    procd_set_param command /usr/libexec/openrkn/watchdog
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    rm -f /var/run/openrkn/desired /var/run/openrkn/share.link
}
service_triggers() { procd_add_reload_trigger openrkn; }
reload_service() { stop; start; }
